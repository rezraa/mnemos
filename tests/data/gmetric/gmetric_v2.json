  "3_score": {
    "formula": "recall@k = (# E-golds whose acceptable_ids intersect the method's top-k) / E-golds",
    "method_output_contract": "Per problem the method emits a rank-ordered list of DISTINCT corpus pattern ids. BASELINE = match_structural_signals(query) -> for each matched rule in index order append recommended_pattern then alternatives, dedup preserving first-seen. AFTER (S1) = the ported signal-index engine over the SAME frozen queries + corpus.",
    "metric": "concept_recall_at_k",
    "primary_cutoff_k": 10,
    "secondary_cutoff_k": 5
  },
